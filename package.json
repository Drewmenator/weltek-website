{
  "name": "weltek-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:only": "node --test tests/*.test.mjs",
    "test": "npm run build && (npx next start -p 3999 >/dev/null 2>&1 &) && for i in $(seq 1 40); do curl -sf -o /dev/null http://127.0.0.1:3999 && break || sleep 1; done && BASE_URL=http://127.0.0.1:3999 node --test tests/*.test.mjs; code=$?; pkill -f 'next start -p 3999' >/dev/null 2>&1; exit $code"
  },
  "dependencies": {
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.17.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "^8.5.25",
    "sharp": "^0.35.3",
    "brace-expansion@1": "^1.1.18",
    "brace-expansion@5": "^5.0.9"
  }
}
